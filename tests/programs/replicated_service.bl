// Test: on replicated(N) directive for service replication

substrate KeyValueStore<T> {
    op put(key: String, value: T) -> String
    op get(key: String) -> T
    op delete(key: String) -> String
    emits {
        put_accepted
        put_committed
        entry_available
        delete_committed
    }
}

port KV {
    put(key: String, value: String) -> String [command]
    get(key: String) -> String? [query, visible(put_committed)]
}

service ReplicatedKV provides KV {
    publish as "kv/replicated"
    on replicated(3)
    component store = spawn KeyValueStore("kv/replicated_store")

    command put(key: String, value: String) -> String
        via store.put(key, value)
        settle store.put_committed by ack.key

    query get(key: String) -> String? {
        return store.get(key)
    }
}

entry(out: cap Stdout @delegate) {
    let kv = resolve KV["kv/replicated"]
    await kv.put("key1", "value1")
    await out.writeln("replicated service operational")
}
