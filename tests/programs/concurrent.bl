// Test: ConcurrentAwait for parallel dispatch

substrate KeyValueStore<T> {
    op put(key: String, value: T) -> String
    op get(key: String) -> T
    op delete(key: String) -> String
    emits {
        put_accepted
        put_committed
        entry_available
        delete_committed
    }
}

port KV {
    put(key: String, value: String) -> String [command]
    get(key: String) -> String? [query, visible(put_committed)]
}

service KVService provides KV {
    publish as "kv/concurrent"
    component store = spawn KeyValueStore("kv/concurrent_store")

    command put(key: String, value: String) -> String
        via store.put(key, value)
        settle store.put_committed by ack.key

    query get(key: String) -> String? {
        return store.get(key)
    }
}

entry(out: cap Stdout @delegate) {
    let kv = resolve KV["kv/concurrent"]

    // Store some values first
    await kv.put("a", "alpha")
    await kv.put("b", "beta")
    await kv.put("c", "gamma")

    // Fetch multiple values concurrently
    let results = concurrent {
        kv.get("a")
        kv.get("b")
        kv.get("c")
    }

    await out.writeln("concurrent results fetched: " + results.len())
}
