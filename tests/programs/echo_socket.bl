// Phase 5: Socket substrate smoke test
// Uses UDP loopback to test basic socket I/O with Bytes

port SocketPort {
    echo_test() -> Int [command]
}

service EchoService provides SocketPort {
    publish as "echo/main"
    component sock = spawn Socket("echo/sock")

    command echo_test() -> Int {
        // Bind a UDP socket to a random local port
        let handle = await sock.udp_bind("127.0.0.1:0")
        // Send some bytes to ourselves (port 0 means OS picks; we'd need the actual addr)
        // For this smoke test, just verify bind + close work
        await sock.close(handle)
        return 1
    }
}

entry() {
    let s = resolve SocketPort["echo/main"]
    let result = await s.echo_test()
    return result
}
