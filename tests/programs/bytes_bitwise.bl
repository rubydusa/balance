// Phase 1: Bytes type + bitwise operators test

entry() {
    // Bytes literal
    let buf = b"48656c6c6f"
    let first = buf[0]
    // first should be 72 (0x48 = 'H')

    // Hex integer literal
    let mask = 0xFF & 0x0F
    // mask = 15

    // Shift operators
    let shifted = 1 << 8
    // shifted = 256

    // Bitwise NOT
    let flipped = ~0
    // flipped = -1

    // XOR
    let xored = 0xAA ^ 0x55
    // xored = 255

    // Bytes methods
    let len = buf.len()
    let byte_at = buf.at(1)
    let sliced = buf.slice(0, 3)
    let hex = buf.hex()
    let as_list = buf.to_list()
    let as_str = buf.to_string()

    // Bytes concat
    let a = b"0102"
    let b = b"0304"
    let c = a.concat(b)

    // Bitwise OR
    let ored = 0x0F | 0xF0
    // ored = 255

    // Precedence: shift before add
    let prec = 1 + 1 << 3
    // should be 1 + (1 << 3) = 1 + 8 = 9
    // wait, shift is prec 8, add is prec 9, so add binds tighter
    // Actually: higher precedence = tighter binding
    // add (9) > shift (8), so: (1 + 1) << 3 = 2 << 3 = 16
    // No wait - let me re-check. In Pratt parsing, higher number = tighter.
    // shift is 8, add is 9. So add (9) > shift (8), meaning add binds first.
    // So: (1 + 1) << 3 = 2 << 3 = 16

    return first
}
